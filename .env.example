# OPS PILOT - Environment Configuration

# General
ENVIRONMENT=development
PROJECT_NAME="OPS PILOT"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL + pgvector / SQLite fallback)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_pass@localhost:5432/opspilot
DATABASE_URL_SYNC=postgresql://opspilot:opspilot_pass@localhost:5432/opspilot
# For local dev / testing fallback without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./opspilot.db
# DATABASE_URL_SYNC=sqlite:///./opspilot.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# LLM Providers Configuration
# Supported providers: gemini | openai | anthropic | mock
DEFAULT_LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Security & CORS
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
